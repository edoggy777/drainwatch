# Copy this file to ".env" and fill it in.

# Base mainnet RPC from Alchemy/Infura/QuickNode (free tier is fine)
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional: Telegram alerts. Leave blank to just print alerts in the terminal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert when a watched balance drops this % within WINDOW_BLOCKS blocks
DROP_PCT=20
WINDOW_BLOCKS=30
POLL_SECONDS=2
COOLDOWN_SECONDS=600
EXPLORER_URL=https://basescan.org
